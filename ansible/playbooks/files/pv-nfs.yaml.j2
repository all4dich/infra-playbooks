  claimRef:
    namespace: kubeflow
    name: mysql-pv-claim
---
apiVersion: v1
kind: PersistentVolume
metadata:
  name: katib-mysql
spec:
  capacity:
    storage: 20Gi
  accessModes:
    - ReadWriteOnce
  persistentVolumeReclaimPolicy: Retain
  storageClassName: ""
  nfs:
    path: /mnt/share/k8s/katib-mysql
    server: {{ nfs_server_ip }}
  volumeMode: Filesystem
  claimRef:
    namespace: kubeflow
    name: katib-mysql
